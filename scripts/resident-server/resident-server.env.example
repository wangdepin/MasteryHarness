# Settings for the resident server. Copy to
#   ~/Library/Application Support/MasteryHarness-server/server.env
# and make it private:  chmod 600 server.env
# KEY=VALUE lines only; nothing here is run by a shell.

# The access token every device pairs with. Generate one with: openssl rand -hex 32
# Changing it signs every paired device out.
LH_ACCESS_TOKEN=

# Listen on this Mac only. Tailscale Serve is what other devices reach.
HOSTNAME=127.0.0.1
PORT=4747

# The desktop app's own data and sign-ins, so both see the same lessons.
# Never run the desktop app and this server at the same time.
LH_DATA_DIR=/Users/YOU/Library/Application Support/MasteryHarness/data
LH_AUTH_FILE=/Users/YOU/Library/Application Support/MasteryHarness/auth.json

# The name Tailscale Serve gives this Mac (tailscale serve status shows it).
LH_ALLOWED_HOSTS=your-mac.your-tailnet.ts.net

# launchd starts programs with a bare PATH. List the folders that hold
# node, the claude CLI and the runtimes coding questions use.
PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

# Optional: the Chrome that renders demos. Without it the server looks for
# an installed Google Chrome.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
